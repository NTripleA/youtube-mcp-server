# Dependencies
node_modules/

# package-lock.json is intentionally COMMITTED: the Docker build uses `npm ci`,
# which requires it, and reproducible builds on the Pi depend on it.

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build directories
/build
/dist

# OS-specific files
.DS_Store
Thumbs.db

# OAuth credentials. Tokens live outside the checkout (see YOUTUBE_TOKEN_FILE),
# but this stays as a backstop against an accidental legacy token.json.
token.json
*.token.json

# Local runtime state / media used during manual testing
/state
/media

# Private environment files; keep sanitized templates shareable.
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template
.dev.vars
.dev.vars.*

# Local MCP client configuration may contain credentials.
.mcp.json
.mcp.local.json
claude_desktop_config.json

# Credentials, OAuth clients, cookies, and runtime sessions.
credentials.json
credentials.*.json
client_secret*.json
client_secrets*.json
service-account*.json
service_account*.json
token.json
token.*.json
*.token.json
tokens.json
session.json
session.*.json
session.pickle
session.pkl
cookies.json
cookies.txt
.cookies
.git-credentials
secrets/
.secrets/

# Local Cloudflare configuration and private key material.
.cloudflared/
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
