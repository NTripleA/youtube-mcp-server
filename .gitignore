# Dependencies
node_modules/

# package-lock.json is intentionally COMMITTED: the Docker build uses `npm ci`,
# which requires it, and reproducible builds on the Pi depend on it.

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build directories
/build
/dist

# OS-specific files
.DS_Store
Thumbs.db

# OAuth credentials. Tokens live outside the checkout (see YOUTUBE_TOKEN_FILE),
# but this stays as a backstop against an accidental legacy token.json.
token.json
*.token.json

# Local runtime state / media used during manual testing
/state
/media
