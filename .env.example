# ---------------------------------------------------------------------------
# youtube-mcp-server configuration
#
# Local (stdio) use: copy to .env. Remote (Pi) use: this is the template for
# /opt/mcp/youtube/youtube-mcp.env - see docs/DEPLOY-PI.md.
# ---------------------------------------------------------------------------

# -- Public read access -----------------------------------------------------
# Enough on its own for search_videos / get_video_details / list_comments.
YOUTUBE_API_KEY=your_youtube_api_key_here

# -- OAuth (channel access) -------------------------------------------------
# From Google Cloud Console > Credentials > OAuth client ID > "Desktop app".
# Required for analytics and for every write tool.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Where the refresh token is stored. NEVER inside the Git checkout - the server
# refuses to start if this resolves into the project directory.
# Local default:  ~/.config/youtube-mcp/token.json
# In the container: /state/token.json
# YOUTUBE_TOKEN_FILE=

# -- Channel lock -----------------------------------------------------------
# The ONLY channel this deployment may modify. Required in HTTP mode whenever
# writes are enabled; the server exits at startup without it. `npm run auth`
# prints the correct value.
YOUTUBE_ALLOWED_CHANNEL_ID=

# -- Write switch -----------------------------------------------------------
# Absent or anything other than "true"/"1" => writes are OFF.
# Default: OFF in HTTP mode, ON in stdio mode.
# Changing this in the Pi env file needs `docker compose up -d --force-recreate`,
# NOT `docker restart`.
YOUTUBE_ENABLE_WRITES=false

# -- Transport --------------------------------------------------------------
# stdio (default) or http.
# MCP_TRANSPORT=http
# Defaults to 127.0.0.1. The container image sets 0.0.0.0 itself; do not set it
# here unless you know why.
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8000

# Host header allowlist. The loopback forms for the port the SERVER binds are
# always allowed automatically; this extends that list. Two entries are needed
# for the Pi deployment:
#
#   1. Your public hostname - cloudflared forwards the original Host by default.
#      (If your tunnel ingress sets httpHostHeader, put THAT value here instead.)
#   2. The loopback form of the PUBLISHED host port. The container binds 8000
#      but Docker publishes it as 127.0.0.1:8003, so a local `curl` sends
#      "Host: 127.0.0.1:8003", which the automatic defaults cannot predict from
#      inside the container. Without this, local diagnostics get 403.
#
# MCP_ALLOWED_HOSTS=youtube.example.com,127.0.0.1:8003,localhost:8003

# Origin allowlist. Unset => no Origin restriction. A request that omits Origin
# (normal for server-to-server clients) is never rejected either way; only a
# present-but-unlisted Origin is refused.
# MCP_ALLOWED_ORIGINS=https://claude.ai

# -- Thumbnails -------------------------------------------------------------
# Directory imagePath is confined to. Container default: /media.
# Unset in stdio mode => imagePath is refused and only imageUrl works.
# YOUTUBE_MEDIA_DIR=/media

# Default 2 MiB (YouTube's documented limit); capped at the API maximum.
# YOUTUBE_THUMBNAIL_MAX_BYTES=2097152

# Optional extra restriction on imageUrl. Not required for ordinary public
# HTTPS images, which are already validated against private/internal addresses.
# YOUTUBE_THUMBNAIL_URL_ALLOWED_HOSTS=cdn.example.com
