credentials.json
**/credentials.json
credentials.*.json
**/credentials.*.json
client_secret*.json
**/client_secret*.json
client_secrets*.json
**/client_secrets*.json
service-account*.json
**/service-account*.json
service_account*.json
**/service_account*.json
token.json
**/token.json
token.*.json
**/token.*.json
*.token.json
**/*.token.json
tokens.json
**/tokens.json
session.json
**/session.json
session.*.json
**/session.*.json
session.pickle
**/session.pickle
session.pkl
**/session.pkl
cookies.json
**/cookies.json
cookies.txt
**/cookies.txt
.cookies
**/.cookies
.git-credentials
**/.git-credentials
secrets/
**/secrets/
.secrets/
**/.secrets/

