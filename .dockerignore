# Never let credentials or local state into the build context.
.env
.env.*
!.env.example
token.json
*.token.json
state/
media/

# Not needed at runtime
.git
.gitignore
node_modules
test
docs
README.md
SOUL.md
LICENSE
.DS_Store
*.log
Dockerfile*
docker-compose.yml

# Private environment files; keep sanitized templates shareable.
.env
**/.env
.env.*
**/.env.*
!.env.example
!**/.env.example
!.env.*.example
!**/.env.*.example
!.env.sample
!**/.env.sample
!.env.template
!**/.env.template
.dev.vars
**/.dev.vars
.dev.vars.*
**/.dev.vars.*

# Local MCP client configuration may contain credentials.
.mcp.json
**/.mcp.json
.mcp.local.json
**/.mcp.local.json
claude_desktop_config.json
**/claude_desktop_config.json

